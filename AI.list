#!name = All-in-One AI 全链路分流插件 (含跳转鉴权)
#!desc = 涵盖 Apple Intelligence、OpenAI、Claude、Gemini、Meta、Copilot、Cursor、Trae、Grok 及其配套 SSO 跳转验证域名。
#!author = Custom
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bot.png
#!select = AI 节点策略, PROXY, 美国节点, AI, 节点选择
#!date = 2026-11-06

[General]
# 确保 Apple PCC 及 Siri 语音高敏感域名在 Fake-IP 模式下直接返回真实 IP
real-ip = *.apple-relay.apple.com, *.apple-relay.cloudflare.com, *.guzzoni.apple.com, *.smoot.apple.com, *.gspe1-ssl.ls.apple.com, *.configuration.ls.apple.com

[Rule]
# 0. 通用 AI 鉴权、人机验证与支付风控
DOMAIN, challenges.cloudflare.com, AI 节点策略
DOMAIN-SUFFIX, auth0.com, AI 节点策略
DOMAIN-SUFFIX, arkoselabs.com, AI 节点策略
DOMAIN-SUFFIX, funcaptcha.com, AI 节点策略
DOMAIN-SUFFIX, intercom.io, AI 节点策略
DOMAIN-SUFFIX, intercomcdn.com, AI 节点策略
DOMAIN-SUFFIX, stripe.com, AI 节点策略
DOMAIN-SUFFIX, stripecdn.com, AI 节点策略

# 1. OpenAI ChatGPT
AND, ((DOMAIN-KEYWORD, chatgpt-async-webps-prod-), (DOMAIN-SUFFIX, webpubsub.azure.com)), AI 节点策略
AND, ((DOMAIN-KEYWORD, openaicom-api-), (DOMAIN-SUFFIX, azurefd.net)), AI 节点策略
DOMAIN, chatgpt.livekit.cloud, AI 节点策略
DOMAIN, host.livekit.cloud, AI 节点策略
